---
permalink: /write/
eleventyExcludeFromCollections: true
---
{% raw %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Writer · Poker Study</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✎</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --paper: #f6f0e1; --paper-deep: #eee5cf; --ink: #22301f; --ink-soft: #5c6653;
      --felt: #1e6b4e; --oxblood: #8e2f2f; --gold: #b98a2f; --rule: #d8ccae;
      --mono: "JetBrains Mono", ui-monospace, monospace;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--paper); color: var(--ink);
      font-family: "Newsreader", Georgia, serif; min-height: 100dvh;
    }
    button {
      font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.06em;
      text-transform: uppercase; cursor: pointer; border: none; border-radius: 999px;
      padding: 0.55em 1.3em; background: var(--felt); color: var(--paper);
    }
    button:hover { background: var(--oxblood); }
    button.ghost { background: none; color: var(--ink-soft); border: 1px solid var(--rule); }
    button.ghost:hover { color: var(--oxblood); border-color: var(--oxblood); background: none; }
    button:disabled { opacity: 0.5; cursor: default; }
    input, textarea {
      font-family: inherit; color: var(--ink); background: transparent;
      border: none; outline: none; width: 100%;
    }

    /* ── Gate ── */
    #gate {
      min-height: 100dvh; display: flex; align-items: center; justify-content: center; padding: 1.5rem;
    }
    .gate-card {
      width: min(24rem, 100%); text-align: center; background: #fbf7ec;
      border: 1px solid var(--rule); border-radius: 14px; padding: 2.5rem 2rem;
      box-shadow: 0 20px 50px -30px rgba(34, 48, 31, 0.4);
    }
    .gate-card .suits { color: var(--oxblood); letter-spacing: 0.6em; font-size: 0.8rem; }
    .gate-card h1 { font-family: "Fraunces", Georgia, serif; font-size: 1.7rem; margin: 0.5rem 0 1.5rem; }
    .gate-card input {
      border: 1px solid var(--rule); border-radius: 8px; padding: 0.6em 0.9em;
      font-size: 1rem; background: #fff; margin-bottom: 0.8rem;
    }
    .gate-card input:focus { border-color: var(--felt); }
    .gate-hint { font-size: 0.85rem; color: var(--ink-soft); font-style: italic; margin: 1rem 0 0; }
    .gate-err { color: var(--oxblood); font-size: 0.9rem; min-height: 1.3em; margin: 0.5rem 0; }
    #setup-extra { display: none; text-align: left; }
    #setup-extra p { font-size: 0.85rem; color: var(--ink-soft); margin: 0.2rem 0 0.6rem; }
    .linkish { background: none; border: none; color: var(--felt); text-decoration: underline;
      text-transform: none; letter-spacing: 0; font-size: 0.8rem; padding: 0; }
    .linkish:hover { background: none; color: var(--oxblood); }

    /* ── App ── */
    #app { display: none; min-height: 100dvh; }
    #app.on { display: grid; grid-template-columns: 15.5rem 1fr; }
    aside {
      border-right: 1px solid var(--rule); background: var(--paper-deep);
      padding: 1.25rem 1rem; display: flex; flex-direction: column; gap: 0.5rem;
      height: 100dvh; position: sticky; top: 0; overflow-y: auto;
    }
    .side-head { font-family: "Fraunces", Georgia, serif; font-weight: 700; font-size: 1.1rem; margin: 0 0 0.4rem; }
    .side-head a { color: var(--ink); text-decoration: none; }
    .side-head a:hover { color: var(--oxblood); }
    #note-list { list-style: none; margin: 0.5rem 0; padding: 0; flex: 1; }
    #note-list li {
      padding: 0.45rem 0.55rem; border-radius: 6px; cursor: pointer;
      font-size: 0.92rem; line-height: 1.3;
    }
    #note-list li:hover { background: #e4d9bd; }
    #note-list li.active { background: var(--felt); color: var(--paper); }
    #note-list li time { display: block; font-family: var(--mono); font-size: 0.62rem;
      letter-spacing: 0.1em; opacity: 0.75; }
    .side-foot { display: flex; gap: 0.5rem; flex-wrap: wrap; }

    #editor { padding: 3rem clamp(1.25rem, 6vw, 4.5rem); max-width: 52rem; }
    #f-title {
      font-family: "Fraunces", Georgia, serif; font-weight: 700;
      font-size: clamp(1.8rem, 4.5vw, 2.4rem); line-height: 1.15; letter-spacing: -0.015em;
    }
    #f-title::placeholder, #f-summary::placeholder, #f-body::placeholder { color: #b6ac91; }
    #f-summary { font-style: italic; font-size: 1.05rem; color: var(--ink-soft); margin-top: 0.4rem; }
    #f-body {
      margin-top: 1.6rem; font-size: 1.1rem; line-height: 1.65; resize: none;
      min-height: 55dvh; border-top: 1px solid var(--rule); padding-top: 1.4rem;
    }
    .bar {
      display: flex; align-items: center; gap: 0.8rem; margin-bottom: 2rem;
      font-family: var(--mono); font-size: 0.75rem; color: var(--ink-soft);
    }
    .bar .grow { flex: 1; }
    #status { font-style: normal; }
    #status.ok { color: var(--felt); }
    #status.err { color: var(--oxblood); }

    @media (max-width: 720px) {
      #app.on { grid-template-columns: 1fr; }
      aside { height: auto; position: static; }
      #editor { padding: 1.5rem 1.25rem; }
    }
  </style>
</head>
<body>

<div id="gate">
  <form class="gate-card" id="gate-form">
    <div class="suits" aria-hidden="true">♠ ♥ ♦ ♣</div>
    <h1>Poker Study</h1>
    <input type="password" id="g-pass" placeholder="password" autocomplete="current-password" autofocus>
    <div id="setup-extra">
      <p><strong>First-time setup:</strong> paste a fine-grained GitHub token scoped to
      <em>poker-study</em> with Contents read&nbsp;&amp;&nbsp;write. It gets encrypted with your
      password and saved to the repo — after this, it's password-only on every device.</p>
      <input type="password" id="g-token" placeholder="github_pat_…">
    </div>
    <div class="gate-err" id="g-err"></div>
    <button type="submit" id="g-btn">Enter</button>
    <p class="gate-hint" id="g-hint"></p>
    <p><button type="button" class="linkish" id="g-reset" style="display:none">re-run setup (rotate token/password)</button></p>
  </form>
</div>

<div id="app">
  <aside>
    <h2 class="side-head"><a href="/">♠ Poker Study</a></h2>
    <button id="b-new">+ New note</button>
    <ul id="note-list"></ul>
    <div class="side-foot">
      <button class="ghost" id="b-delete">Delete</button>
      <button class="ghost" id="b-logout">Log out</button>
    </div>
  </aside>
  <section id="editor">
    <div class="bar">
      <span id="f-name">new note</span>
      <span class="grow"></span>
      <span id="status"></span>
      <button id="b-save">Publish</button>
    </div>
    <input id="f-title" placeholder="Untitled">
    <input id="f-summary" placeholder="One-line summary (optional)">
    <textarea id="f-body" placeholder="Write in markdown…"></textarea>
  </section>
</div>

<script>
const REPO = "Bijig0/poker-study";
const API = "https://api.github.com/repos/" + REPO;
const CONFIG_PATH = "write-config.json";
const LS_KEY = "poker-study-pass";

let token = null;          // decrypted GitHub token
let config = null;         // {salt, iv, ct} or null if not set up
let configSha = null;
let notes = [];            // [{name, sha}]
let current = null;        // filename of open note, null = new
let currentSha = null;
let dirty = false;

const $ = (id) => document.getElementById(id);

/* ── crypto ── */
const te = new TextEncoder(), td = new TextDecoder();
const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
const unb64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));

async function deriveKey(pass, salt) {
  const base = await crypto.subtle.importKey("raw", te.encode(pass), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey(
    { name: "PBKDF2", salt, iterations: 310000, hash: "SHA-256" },
    base, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
}
async function encryptToken(pass, tok) {
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const key = await deriveKey(pass, salt);
  const ct = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, te.encode(tok));
  return { salt: b64(salt), iv: b64(iv), ct: b64(ct) };
}
async function decryptToken(pass, cfg) {
  const key = await deriveKey(pass, unb64(cfg.salt));
  const pt = await crypto.subtle.decrypt({ name: "AES-GCM", iv: unb64(cfg.iv) }, key, unb64(cfg.ct));
  return td.decode(pt);
}

/* ── github api ── */
const utf8ToB64 = (s) => btoa(unescape(encodeURIComponent(s)));
const b64ToUtf8 = (s) => decodeURIComponent(escape(atob(s.replace(/\n/g, ""))));

async function gh(path, opts = {}) {
  const headers = { Accept: "application/vnd.github+json", ...(opts.headers || {}) };
  if (token) headers.Authorization = "Bearer " + token;
  const res = await fetch(API + path, { ...opts, headers });
  if (res.status === 404) return null;
  if (!res.ok) throw new Error("GitHub API " + res.status + ": " + (await res.text()).slice(0, 200));
  return res.json();
}
async function putFile(path, contentStr, message, sha) {
  const body = { message, content: utf8ToB64(contentStr) };
  if (sha) body.sha = sha;
  return gh("/contents/" + path, { method: "PUT", body: JSON.stringify(body) });
}

/* ── gate ── */
async function loadConfig() {
  const f = await gh("/contents/" + CONFIG_PATH + "?t=" + Math.random().toString(36).slice(2));
  if (f) { config = JSON.parse(b64ToUtf8(f.content)); configSha = f.sha; }
}
function setupMode(on) {
  $("setup-extra").style.display = on ? "block" : "none";
  $("g-btn").textContent = on ? "Set up & enter" : "Enter";
  $("g-reset").style.display = on ? "none" : "inline";
}
$("g-reset").onclick = () => setupMode(true);

$("gate-form").onsubmit = async (e) => {
  e.preventDefault();
  const pass = $("g-pass").value;
  const newTok = $("g-token").value.trim();
  $("g-err").textContent = "";
  $("g-btn").disabled = true;
  try {
    if (newTok) {                      // setup / rotate
      token = newTok;
      const who = await gh("");        // validates token against this repo
      if (!who || !who.permissions || !who.permissions.push) throw new Error("That token can't write to " + REPO);
      const cfg = await encryptToken(pass, newTok);
      await putFile(CONFIG_PATH, JSON.stringify(cfg, null, 2), "writer: update credentials", configSha);
      config = cfg;
    } else {
      if (!config) { setupMode(true); throw new Error("No setup found yet — paste a token below once."); }
      token = await decryptToken(pass, config).catch(() => { throw new Error("Wrong password."); });
    }
    localStorage.setItem(LS_KEY, pass);
    enterApp();
  } catch (err) {
    token = null;
    $("g-err").textContent = err.message;
  }
  $("g-btn").disabled = false;
};

/* ── app ── */
async function enterApp() {
  $("gate").style.display = "none";
  $("app").classList.add("on");
  await refreshList();
  const want = new URLSearchParams(location.search).get("note");
  if (want && notes.some((n) => n.name === want)) openNote(want);
}
async function refreshList() {
  const files = (await gh("/contents/notes")) || [];
  notes = files.filter((f) => f.name.endsWith(".md")).sort((a, b) => b.name.localeCompare(a.name));
  const ul = $("note-list");
  ul.innerHTML = "";
  for (const n of notes) {
    const li = document.createElement("li");
    const m = n.name.match(/^(\d{4}-\d{2}-\d{2})-(.*)\.md$/) || [null, "", n.name];
    li.innerHTML = "<time>" + m[1] + "</time>" + m[2].replace(/-/g, " ");
    li.dataset.name = n.name;
    if (n.name === current) li.classList.add("active");
    li.onclick = () => confirmLose() && openNote(n.name);
    ul.appendChild(li);
  }
}
function confirmLose() {
  return !dirty || confirm("Discard unpublished changes?");
}
function markDirty(d) {
  dirty = d;
  $("status").textContent = d ? "unpublished changes" : "";
  $("status").className = "";
}
for (const id of ["f-title", "f-summary", "f-body"]) $(id).oninput = () => markDirty(true);
window.onbeforeunload = () => (dirty ? true : undefined);

function parseNote(raw) {
  const m = raw.match(/^---\n([\s\S]*?)\n---\n?/);
  let title = "", summary = "", body = raw;
  if (m) {
    body = raw.slice(m[0].length).replace(/^\n/, "");
    const t = m[1].match(/^title:\s*"?(.*?)"?\s*$/m);
    const s = m[1].match(/^summary:\s*"?(.*?)"?\s*$/m);
    if (t) title = t[1];
    if (s) summary = s[1];
  }
  return { title, summary, body };
}
function composeNote() {
  const esc = (s) => s.replace(/"/g, "'");
  let fm = '---\ntitle: "' + esc($("f-title").value.trim() || "Untitled") + '"\n';
  const sum = $("f-summary").value.trim();
  if (sum) fm += 'summary: "' + esc(sum) + '"\n';
  return fm + "---\n\n" + $("f-body").value.replace(/\s*$/, "") + "\n";
}
async function openNote(name) {
  const f = await gh("/contents/notes/" + name);
  if (!f) return;
  const { title, summary, body } = parseNote(b64ToUtf8(f.content));
  current = name; currentSha = f.sha;
  $("f-name").textContent = name;
  $("f-title").value = title; $("f-summary").value = summary; $("f-body").value = body;
  markDirty(false);
  refreshList();
}
$("b-new").onclick = () => {
  if (!confirmLose()) return;
  current = null; currentSha = null;
  $("f-name").textContent = "new note";
  $("f-title").value = ""; $("f-summary").value = ""; $("f-body").value = "";
  markDirty(false);
  refreshList();
  $("f-title").focus();
};
$("b-save").onclick = async () => {
  $("b-save").disabled = true;
  $("status").textContent = "publishing…"; $("status").className = "";
  try {
    if (!current) {
      const n = new Date();
      const d = n.getFullYear() + "-" + String(n.getMonth() + 1).padStart(2, "0") + "-" + String(n.getDate()).padStart(2, "0");
      const slug = ($("f-title").value.trim() || "untitled").toLowerCase()
        .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 60) || "untitled";
      current = d + "-" + slug + ".md";
      $("f-name").textContent = current;
    }
    const res = await putFile("notes/" + current, composeNote(),
      "note: " + ($("f-title").value.trim() || current), currentSha);
    currentSha = res.content.sha;
    markDirty(false);
    $("status").textContent = "published — live in ~1 min"; $("status").className = "ok";
    refreshList();
  } catch (err) {
    $("status").textContent = err.message; $("status").className = "err";
  }
  $("b-save").disabled = false;
};
$("b-delete").onclick = async () => {
  if (!current) return;
  if (!confirm("Delete " + current + " for good?")) return;
  await gh("/contents/notes/" + current, {
    method: "DELETE",
    body: JSON.stringify({ message: "delete: " + current, sha: currentSha }),
  });
  $("b-new").onclick();
};
$("b-logout").onclick = () => {
  localStorage.removeItem(LS_KEY);
  token = null;
  location.reload();
};

/* ── boot ── */
(async () => {
  try { await loadConfig(); } catch (e) { $("g-err").textContent = e.message; }
  if (!config) { setupMode(false); setupMode(true); $("g-hint").textContent = "one-time setup on first use"; return; }
  const saved = localStorage.getItem(LS_KEY);
  if (saved) {
    try { token = await decryptToken(saved, config); enterApp(); return; } catch (e) { localStorage.removeItem(LS_KEY); }
  }
})();
</script>
</body>
</html>
{% endraw %}
