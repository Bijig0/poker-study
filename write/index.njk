---
permalink: /write/
eleventyExcludeFromCollections: true
---
{% raw %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Writer · Poker Study</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✎</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..900&family=Newsreader:ital,opsz@0,6..72;1,6..72&display=swap" rel="stylesheet">
  <style>
    :root {
      /* gate (matches the site) */
      --paper: #f6f0e1; --ink: #22301f; --ink-soft: #5c6653; --felt: #1e6b4e;
      --oxblood: #8e2f2f; --rule: #d8ccae;
      /* obsidian-dark app */
      --s-bg: #1c1c1c;         /* sidebar */
      --e-bg: #202020;         /* editor */
      --text: #dcddde;
      --muted: #8b8b8b;
      --faint: #666;
      --accent: #8a7cff;
      --hover: #272727;
      --active: #333333;
      --border: #333333;
      --danger: #e9595d;
      --ui: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body { margin: 0; font-family: var(--ui); }

    /* ── Gate ── */
    #gate {
      min-height: 100dvh; display: flex; align-items: center; justify-content: center;
      padding: 1.5rem; background: var(--paper); color: var(--ink);
      font-family: "Newsreader", Georgia, serif;
    }
    .gate-card {
      width: min(24rem, 100%); text-align: center; background: #fbf7ec;
      border: 1px solid var(--rule); border-radius: 14px; padding: 2.5rem 2rem;
      box-shadow: 0 20px 50px -30px rgba(34, 48, 31, 0.4);
    }
    .gate-card .suits { color: var(--oxblood); letter-spacing: 0.6em; font-size: 0.8rem; }
    .gate-card h1 { font-family: "Fraunces", Georgia, serif; font-size: 1.7rem; margin: 0.5rem 0 1.5rem; }
    .gate-card input {
      width: 100%; border: 1px solid var(--rule); border-radius: 8px; padding: 0.6em 0.9em;
      font-size: 1rem; background: #fff; margin-bottom: 0.8rem; font-family: inherit;
      color: var(--ink); outline: none;
    }
    .gate-card input:focus { border-color: var(--felt); }
    .gate-card button {
      font-family: ui-monospace, monospace; font-size: 0.78rem; letter-spacing: 0.06em;
      text-transform: uppercase; cursor: pointer; border: none; border-radius: 999px;
      padding: 0.55em 1.3em; background: var(--felt); color: var(--paper);
    }
    .gate-card button:hover { background: var(--oxblood); }
    .gate-hint { font-size: 0.85rem; color: var(--ink-soft); font-style: italic; margin: 1rem 0 0; }
    .gate-err { color: var(--oxblood); font-size: 0.9rem; min-height: 1.3em; margin: 0.5rem 0; }
    #setup-extra { display: none; text-align: left; }
    #setup-extra p { font-size: 0.85rem; color: var(--ink-soft); margin: 0.2rem 0 0.6rem; }
    .linkish { background: none !important; border: none; color: var(--felt) !important;
      text-decoration: underline; text-transform: none !important; letter-spacing: 0 !important;
      font-size: 0.8rem !important; padding: 0 !important; cursor: pointer; }

    /* ── App shell ── */
    #app { display: none; height: 100dvh; background: var(--e-bg); color: var(--text); }
    #app.on { display: flex; }

    aside {
      width: 270px; min-width: 270px; background: var(--s-bg);
      border-right: 1px solid var(--border);
      display: flex; flex-direction: column; user-select: none;
    }
    .side-top {
      display: flex; align-items: center; justify-content: space-between;
      padding: 10px 10px 6px 14px;
    }
    .vault-name {
      font-size: 12px; font-weight: 600; letter-spacing: 0.05em; color: var(--muted);
      text-transform: uppercase;
    }
    .icons { display: flex; gap: 2px; }
    .icon {
      background: none; border: none; color: var(--muted); cursor: pointer;
      padding: 5px; border-radius: 5px; display: flex;
    }
    .icon:hover { background: var(--hover); color: var(--text); }
    .icon svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2;
      stroke-linecap: round; stroke-linejoin: round; }

    #tree { flex: 1; overflow-y: auto; padding: 4px 8px 40px; outline: none; }
    #tree.droot { box-shadow: inset 0 0 0 2px var(--accent); border-radius: 6px; }

    .row {
      display: flex; align-items: center; gap: 3px;
      padding: 3px 6px; border-radius: 5px; cursor: pointer;
      font-size: 13.5px; line-height: 1.45; color: var(--muted);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .row:hover { background: var(--hover); color: var(--text); }
    .row.active { background: var(--active); color: #fff; }
    .row.drop { box-shadow: inset 0 0 0 2px var(--accent); }
    .row .chev {
      width: 14px; min-width: 14px; height: 14px; display: inline-flex; align-items: center;
      justify-content: center; transition: transform 0.12s ease; color: var(--faint);
    }
    .row .chev svg { width: 10px; height: 10px; stroke: currentColor; fill: none;
      stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
    .row.folder.closed .chev { transform: rotate(-90deg); }
    .row.note { padding-left: 6px; }
    .row .nm { overflow: hidden; text-overflow: ellipsis; }
    .children { margin-left: 15px; border-left: 1px solid #2b2b2b; padding-left: 2px; }
    .folder.closed + .children { display: none; }
    .row input.rn {
      background: var(--e-bg); border: 1px solid var(--accent); border-radius: 4px;
      color: var(--text); font: inherit; padding: 0 4px; width: 100%; outline: none;
    }

    .side-bottom {
      display: flex; gap: 6px; padding: 8px 12px; border-top: 1px solid var(--border);
    }
    .mini {
      background: none; border: none; color: var(--faint); font-size: 11.5px;
      cursor: pointer; text-decoration: none; padding: 3px 6px; border-radius: 4px;
      font-family: var(--ui);
    }
    .mini:hover { background: var(--hover); color: var(--text); }

    /* ── Editor pane ── */
    main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .pane-top {
      display: flex; align-items: center; gap: 10px; padding: 8px 16px;
      border-bottom: 1px solid var(--border); font-size: 12.5px; color: var(--muted);
      min-height: 40px;
    }
    #crumb { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #crumb .sep { color: var(--faint); margin: 0 5px; }
    .grow { flex: 1; }
    #status { font-size: 12px; }
    #status.ok { color: #6fbf8f; }
    #status.err { color: var(--danger); }
    #b-publish {
      background: var(--accent); color: #fff; border: none; border-radius: 6px;
      padding: 5px 14px; font-size: 12.5px; font-weight: 500; cursor: pointer;
      font-family: var(--ui);
    }
    #b-publish:hover { filter: brightness(1.12); }
    #b-publish:disabled { opacity: 0.5; cursor: default; }

    .doc {
      flex: 1; overflow-y: auto; padding: 40px clamp(20px, 8vw, 100px) 60px;
    }
    .doc input, .doc textarea {
      display: block; width: 100%; max-width: 44rem; margin: 0 auto;
      background: transparent; border: none; outline: none; color: var(--text);
      font-family: var(--ui);
    }
    #f-title { font-size: 2em; font-weight: 700; line-height: 1.25; margin-bottom: 2px; }
    #f-title::placeholder, #f-summary::placeholder, #f-body::placeholder { color: #555; }
    #f-summary { font-size: 13.5px; color: var(--muted); font-style: italic; margin-bottom: 18px; }
    #f-body { font-size: 16px; line-height: 1.65; resize: none; min-height: 60vh; }

    /* ── Context menu ── */
    #ctx {
      position: fixed; z-index: 50; display: none; min-width: 168px;
      background: #262626; border: 1px solid #3a3a3a; border-radius: 8px;
      padding: 4px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); font-size: 13px;
    }
    #ctx .mi {
      padding: 5px 10px; border-radius: 5px; cursor: pointer; color: var(--text);
      display: flex; gap: 8px; align-items: center;
    }
    #ctx .mi:hover { background: #333; }
    #ctx .mi.danger { color: var(--danger); }
    #ctx .hr { height: 1px; background: #3a3a3a; margin: 4px 6px; }

    @media (max-width: 720px) {
      #app.on { flex-direction: column; }
      aside { width: 100%; min-width: 0; max-height: 45dvh; }
      .doc { padding: 20px 16px 40px; }
    }
  </style>
</head>
<body>

<div id="gate">
  <form class="gate-card" id="gate-form">
    <div class="suits" aria-hidden="true">♠ ♥ ♦ ♣</div>
    <h1>Poker Study</h1>
    <input type="password" id="g-pass" placeholder="password" autocomplete="current-password" autofocus>
    <div id="setup-extra">
      <p><strong>First-time setup:</strong> paste a fine-grained GitHub token scoped to
      <em>poker-study</em> with Contents read&nbsp;&amp;&nbsp;write. It gets encrypted with your
      password and saved to the repo — after this, it's password-only on every device.</p>
      <input type="password" id="g-token" placeholder="github_pat_…">
    </div>
    <div class="gate-err" id="g-err"></div>
    <button type="submit" id="g-btn">Enter</button>
    <p class="gate-hint" id="g-hint"></p>
    <p><button type="button" class="linkish" id="g-reset" style="display:none">re-run setup (rotate token/password)</button></p>
  </form>
</div>

<div id="app">
  <aside>
    <div class="side-top">
      <span class="vault-name">Poker Study</span>
      <div class="icons">
        <button class="icon" id="i-newnote" title="New note">
          <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
        </button>
        <button class="icon" id="i-newfolder" title="New folder">
          <svg viewBox="0 0 24 24"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.7-.9L9.2 3.9A2 2 0 0 0 7.5 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/><path d="M12 10v6"/><path d="M9 13h6"/></svg>
        </button>
      </div>
    </div>
    <div id="tree"></div>
    <div class="side-bottom">
      <a class="mini" href="/">view site ↗</a>
      <span class="grow"></span>
      <button class="mini" id="b-logout">log out</button>
    </div>
  </aside>
  <main>
    <div class="pane-top">
      <div id="crumb">new note</div>
      <div class="grow"></div>
      <span id="status"></span>
      <button id="b-publish">Publish</button>
    </div>
    <div class="doc">
      <input id="f-title" placeholder="Untitled" spellcheck="false">
      <input id="f-summary" placeholder="Add a one-line summary (shows on the site index)…">
      <textarea id="f-body" placeholder="Write in markdown…"></textarea>
    </div>
  </main>
</div>

<div id="ctx"></div>

<script>
const REPO = "Bijig0/poker-study";
const API = "https://api.github.com/repos/" + REPO;
const CONFIG_PATH = "write-config.json";
const LS_KEY = "poker-study-pass";
const LS_CLOSED = "poker-study-closed";

let token = null, config = null, configSha = null;
let allFiles = [];        // every blob path under notes/ (incl .gitkeep)
let notes = [];           // .md paths under notes/
let treeFolders = [];     // folder paths under notes/
let current = null;       // open note path, null = draft
let currentSha = null, currentDate = "", dirty = false;
let draftFolder = "";     // folder a new draft will publish into

const $ = (id) => document.getElementById(id);
const CHEV = '<svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>';

/* ── crypto ── */
const te = new TextEncoder(), td = new TextDecoder();
const b64 = (buf) => btoa(String.fromCharCode(...new Uint8Array(buf)));
const unb64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
async function deriveKey(pass, salt) {
  const base = await crypto.subtle.importKey("raw", te.encode(pass), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey(
    { name: "PBKDF2", salt, iterations: 310000, hash: "SHA-256" },
    base, { name: "AES-GCM", length: 256 }, false, ["encrypt", "decrypt"]);
}
async function encryptToken(pass, tok) {
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const key = await deriveKey(pass, salt);
  const ct = await crypto.subtle.encrypt({ name: "AES-GCM", iv }, key, te.encode(tok));
  return { salt: b64(salt), iv: b64(iv), ct: b64(ct) };
}
async function decryptToken(pass, cfg) {
  const key = await deriveKey(pass, unb64(cfg.salt));
  const pt = await crypto.subtle.decrypt({ name: "AES-GCM", iv: unb64(cfg.iv) }, key, unb64(cfg.ct));
  return td.decode(pt);
}

/* ── github api ── */
const utf8ToB64 = (s) => btoa(unescape(encodeURIComponent(s)));
const b64ToUtf8 = (s) => decodeURIComponent(escape(atob(s.replace(/\n/g, ""))));
const enc = (p) => p.split("/").map(encodeURIComponent).join("/");
const notePath = (p) => "/contents/notes/" + enc(p);

async function gh(path, opts = {}) {
  const headers = { Accept: "application/vnd.github+json", ...(opts.headers || {}) };
  if (token) headers.Authorization = "Bearer " + token;
  const res = await fetch(API + path, { ...opts, headers });
  if (res.status === 404) return null;
  if (!res.ok) throw new Error("GitHub " + res.status + ": " + (await res.text()).slice(0, 180));
  return res.json();
}
async function putRaw(path, b64content, message, sha) {
  const body = { message, content: b64content };
  if (sha) body.sha = sha;
  return gh("/contents/" + enc(path), { method: "PUT", body: JSON.stringify(body) });
}
const putText = (path, str, message, sha) => putRaw(path, utf8ToB64(str), message, sha);

// One atomic commit for any set of adds/updates/deletes (Git Data API).
// changes: [{path, content}] to write, [{path}] to delete, [{path, sha}] to copy an existing blob.
async function commitChanges(changes, message, attempt = 0) {
  try {
    const ref = await gh("/git/ref/heads/main");
    const head = ref.object.sha;
    const base = (await gh("/git/commits/" + head)).tree.sha;
    const tree = await gh("/git/trees", { method: "POST", body: JSON.stringify({
      base_tree: base,
      tree: changes.map((c) => ({ path: c.path, mode: "100644", type: "blob",
        ...(c.content != null ? { content: c.content } : { sha: c.sha ?? null }) })),
    })});
    const commit = await gh("/git/commits", { method: "POST",
      body: JSON.stringify({ message, tree: tree.sha, parents: [head] }) });
    await gh("/git/refs/heads/main", { method: "PATCH", body: JSON.stringify({ sha: commit.sha }) });
    return commit;
  } catch (e) {
    if (attempt < 2) { await new Promise((r) => setTimeout(r, 900)); return commitChanges(changes, message, attempt + 1); }
    throw e;
  }
}

/* ── status helper ── */
function say(msg, cls) { $("status").textContent = msg; $("status").className = cls || ""; }
function busy(b) { $("b-publish").disabled = b; }

/* ── gate ── */
async function loadConfig() {
  const f = await gh("/contents/" + CONFIG_PATH + "?t=" + Math.random().toString(36).slice(2));
  if (f) { config = JSON.parse(b64ToUtf8(f.content)); configSha = f.sha; }
}
function setupMode(on) {
  $("setup-extra").style.display = on ? "block" : "none";
  $("g-btn").textContent = on ? "Set up & enter" : "Enter";
  $("g-reset").style.display = on ? "none" : "inline";
}
$("g-reset").onclick = () => setupMode(true);
$("gate-form").onsubmit = async (e) => {
  e.preventDefault();
  const pass = $("g-pass").value;
  const newTok = $("g-token").value.trim();
  $("g-err").textContent = "";
  $("g-btn").disabled = true;
  try {
    if (newTok) {
      token = newTok;
      const who = await gh("");
      if (!who || !who.permissions || !who.permissions.push) throw new Error("That token can't write to " + REPO);
      const cfg = await encryptToken(pass, newTok);
      await putText(CONFIG_PATH, JSON.stringify(cfg, null, 2), "writer: update credentials", configSha);
      config = cfg;
    } else {
      if (!config) { setupMode(true); throw new Error("No setup found yet — paste a token below once."); }
      token = await decryptToken(pass, config).catch(() => { throw new Error("Wrong password."); });
    }
    localStorage.setItem(LS_KEY, pass);
    enterApp();
  } catch (err) { token = null; $("g-err").textContent = err.message; }
  $("g-btn").disabled = false;
};

/* ── tree data ── */
const closedFolders = new Set(JSON.parse(localStorage.getItem(LS_CLOSED) || "[]"));
const saveClosed = () => localStorage.setItem(LS_CLOSED, JSON.stringify([...closedFolders]));

const shas = new Map();   // notes-relative path -> blob sha
async function refreshTree(treeSha) {
  // after a commit we read back that exact tree, so the view is never stale
  const t = await gh("/git/trees/" + (treeSha || "main") + "?recursive=1&r=" + Math.random().toString(36).slice(2));
  const entries = (t && t.tree) || [];
  shas.clear();
  allFiles = [];
  for (const x of entries) {
    if (x.type === "blob" && x.path.startsWith("notes/")) {
      const p = x.path.slice(6);
      allFiles.push(p);
      shas.set(p, x.sha);
    }
  }
  notes = allFiles.filter((p) => p.endsWith(".md"));
  treeFolders = entries.filter((x) => x.type === "tree" && x.path.startsWith("notes/"))
    .map((x) => x.path.slice(6));
  renderTree();
}

function buildTree() {
  const root = { folders: {}, notes: [] };
  const mk = (parts) => {
    let node = root;
    for (const seg of parts) { node.folders[seg] ??= { folders: {}, notes: [] }; node = node.folders[seg]; }
    return node;
  };
  for (const f of treeFolders) mk(f.split("/"));
  for (const p of notes) {
    const parts = p.split("/"); const file = parts.pop();
    mk(parts).notes.push({ file, path: p });
  }
  return root;
}

/* ── tree rendering ── */
function renderTree() {
  const tree = $("tree");
  tree.innerHTML = "";
  renderBranch(buildTree(), tree, "");
}
const cmp = (a, b) => a.localeCompare(b, undefined, { sensitivity: "base", numeric: true });

function renderBranch(node, container, prefix) {
  for (const name of Object.keys(node.folders).sort(cmp)) {
    const path = prefix ? prefix + "/" + name : name;
    const row = document.createElement("div");
    row.className = "row folder" + (closedFolders.has(path) ? " closed" : "");
    row.dataset.path = path;
    row.draggable = true;
    row.innerHTML = '<span class="chev">' + CHEV + '</span><span class="nm"></span>';
    row.querySelector(".nm").textContent = name;
    row.onclick = () => {
      row.classList.toggle("closed");
      row.classList.contains("closed") ? closedFolders.add(path) : closedFolders.delete(path);
      saveClosed();
    };
    row.oncontextmenu = (e) => ctxMenu(e, "folder", path);
    dragSetup(row, "folder", path);
    container.appendChild(row);
    const kids = document.createElement("div");
    kids.className = "children";
    renderBranch(node.folders[name], kids, path);
    container.appendChild(kids);
  }
  node.notes.sort((a, b) => cmp(a.file, b.file));
  for (const n of node.notes) {
    const row = document.createElement("div");
    row.className = "row note" + (n.path === current ? " active" : "");
    row.dataset.path = n.path;
    row.draggable = true;
    row.innerHTML = '<span class="nm"></span>';
    row.querySelector(".nm").textContent = n.file.replace(/\.md$/, "");
    row.onclick = () => confirmLose() && openNote(n.path);
    row.oncontextmenu = (e) => ctxMenu(e, "note", n.path);
    dragSetup(row, "note", n.path);
    container.appendChild(row);
  }
}

/* ── drag & drop ── */
let dragged = null; // {kind, path}
function dragSetup(row, kind, path) {
  row.addEventListener("dragstart", (e) => {
    dragged = { kind, path };
    e.dataTransfer.effectAllowed = "move";
    e.dataTransfer.setData("text/plain", path);
  });
  if (kind === "folder") {
    row.addEventListener("dragover", (e) => {
      if (!dragged || !dropAllowed(path)) return;
      e.preventDefault(); row.classList.add("drop");
    });
    row.addEventListener("dragleave", () => row.classList.remove("drop"));
    row.addEventListener("drop", (e) => {
      e.preventDefault(); e.stopPropagation(); row.classList.remove("drop");
      if (dragged && dropAllowed(path)) doMove(dragged, path);
    });
  }
}
function dropAllowed(target) {
  if (!dragged) return false;
  const p = dragged.path;
  if (dragged.kind === "folder") {
    if (target === p || target.startsWith(p + "/")) return false;      // into itself
    if (p.slice(0, p.lastIndexOf("/")) === target) return false;      // no-op
  } else {
    const dir = p.includes("/") ? p.slice(0, p.lastIndexOf("/")) : "";
    if (dir === target) return false;
  }
  return true;
}
// root drop: the tree background moves things to top level
$("tree").addEventListener("dragover", (e) => {
  if (!dragged) return;
  const p = dragged.path;
  const dir = p.includes("/") ? p.slice(0, p.lastIndexOf("/")) : "";
  if (dir === "") return;
  e.preventDefault(); $("tree").classList.add("droot");
});
$("tree").addEventListener("dragleave", (e) => {
  if (e.target === $("tree")) $("tree").classList.remove("droot");
});
$("tree").addEventListener("drop", (e) => {
  e.preventDefault(); $("tree").classList.remove("droot");
  if (!dragged) return;
  const p = dragged.path;
  const dir = p.includes("/") ? p.slice(0, p.lastIndexOf("/")) : "";
  if (dir !== "") doMove(dragged, "");
});
document.addEventListener("dragend", () => {
  dragged = null;
  $("tree").classList.remove("droot");
  document.querySelectorAll(".row.drop").forEach((r) => r.classList.remove("drop"));
});

/* ── core CRUD ops (each is ONE atomic commit) ── */
function folderChanges(oldBase, newBase) {
  // every blob under oldBase (notes and .gitkeep alike) is copied to newBase and removed
  const inside = allFiles.filter((f) => f.startsWith(oldBase + "/"));
  if (!inside.length) throw new Error("Folder not found: " + oldBase);
  const changes = [];
  for (const f of inside) {
    changes.push({ path: "notes/" + newBase + f.slice(oldBase.length), sha: shas.get(f) });
    changes.push({ path: "notes/" + f });
  }
  return { inside, changes };
}
function retarget(oldBase, newBase) {
  if (current && (current === oldBase || current.startsWith(oldBase + "/")))
    current = newBase + current.slice(oldBase.length);
  if (draftFolder && (draftFolder === oldBase || draftFolder.startsWith(oldBase + "/")))
    draftFolder = newBase + draftFolder.slice(oldBase.length);
}

async function moveItem(kind, path, targetFolder) {
  const base = path.split("/").pop();
  if (kind === "note") {
    const dest = (targetFolder ? targetFolder + "/" : "") + base;
    if (notes.includes(dest)) throw new Error("A note with that name is already there.");
    const c = await commitChanges(
      [{ path: "notes/" + dest, sha: shas.get(path) }, { path: "notes/" + path }],
      "note: move " + base);
    if (current === path) current = dest;
    await refreshTree(c.tree.sha);
  } else {
    const destBase = (targetFolder ? targetFolder + "/" : "") + base;
    if (treeFolders.includes(destBase)) throw new Error("A folder with that name is already there.");
    const { changes } = folderChanges(path, destBase);
    const c = await commitChanges(changes, "folder: move " + base);
    retarget(path, destBase);
    await refreshTree(c.tree.sha);
  }
  setCrumb();
}

async function renameItem(kind, path, name) {
  const dir = path.includes("/") ? path.slice(0, path.lastIndexOf("/") + 1) : "";
  if (kind === "note") {
    const dest = dir + name + ".md";
    if (notes.includes(dest)) throw new Error("That name is taken.");
    const c = await commitChanges(
      [{ path: "notes/" + dest, sha: shas.get(path) }, { path: "notes/" + path }],
      "note: rename to " + name);
    if (current === path) { current = dest; $("f-title").value = name; }
    await refreshTree(c.tree.sha);
  } else {
    const dest = dir + name;
    if (treeFolders.includes(dest)) throw new Error("That name is taken.");
    const { changes } = folderChanges(path, dest);
    const c = await commitChanges(changes, "folder: rename to " + name);
    retarget(path, dest);
    await refreshTree(c.tree.sha);
  }
  setCrumb();
}

async function deleteItem(kind, path) {
  let changes;
  if (kind === "note") {
    changes = [{ path: "notes/" + path }];
  } else {
    const inside = allFiles.filter((f) => f.startsWith(path + "/"));
    if (!inside.length) throw new Error("Folder not found: " + path);
    changes = inside.map((f) => ({ path: "notes/" + f }));
  }
  const c = await commitChanges(changes, kind + ": delete " + path);
  if (current && (current === path || current.startsWith(path + "/")))
    newDraft(path.includes("/") ? path.slice(0, path.lastIndexOf("/")) : "");
  if (draftFolder && (draftFolder === path || draftFolder.startsWith(path + "/"))) draftFolder = "";
  await refreshTree(c.tree.sha);
}

async function createFolder(path) {
  if (treeFolders.includes(path)) throw new Error("That folder already exists.");
  const c = await commitChanges([{ path: "notes/" + path + "/.gitkeep", content: "" }], "folder: " + path);
  await refreshTree(c.tree.sha);
}

/* ── drag-drop wrapper ── */
async function doMove(item, targetFolder) {
  busy(true);
  try {
    say("moving…");
    await moveItem(item.kind, item.path, targetFolder);
    say("moved — site updates in ~1 min", "ok");
  } catch (err) { say(err.message, "err"); }
  busy(false);
}

/* ── context menu ── */
const ctx = $("ctx");
function ctxMenu(e, kind, path) {
  e.preventDefault(); e.stopPropagation();
  const items = [];
  if (kind === "folder") {
    items.push(["New note", () => newDraft(path)]);
    items.push(["New folder", () => inlineNewFolder(path)]);
    items.push(["hr"]);
    items.push(["Rename…", () => inlineRename(kind, path)]);
    items.push(["Delete", () => removeItem(kind, path), "danger"]);
  } else if (kind === "note") {
    items.push(["Rename…", () => inlineRename(kind, path)]);
    items.push(["Delete", () => removeItem(kind, path), "danger"]);
  } else {
    items.push(["New note", () => newDraft("")]);
    items.push(["New folder", () => inlineNewFolder("")]);
  }
  ctx.innerHTML = "";
  for (const it of items) {
    if (it[0] === "hr") { const d = document.createElement("div"); d.className = "hr"; ctx.appendChild(d); continue; }
    const mi = document.createElement("div");
    mi.className = "mi" + (it[2] ? " " + it[2] : "");
    mi.textContent = it[0];
    mi.onclick = () => { hideCtx(); it[1](); };
    ctx.appendChild(mi);
  }
  ctx.style.display = "block";
  const x = Math.min(e.clientX, innerWidth - ctx.offsetWidth - 8);
  const y = Math.min(e.clientY, innerHeight - ctx.offsetHeight - 8);
  ctx.style.left = x + "px"; ctx.style.top = y + "px";
}
const hideCtx = () => { ctx.style.display = "none"; };
document.addEventListener("click", hideCtx);
$("tree").addEventListener("contextmenu", (e) => { if (e.target === $("tree")) ctxMenu(e, "root", ""); });

/* ── inline rename / create ── */
const sanitizeName = (s) => s.replace(/[\/\\:*?"<>|#^\[\]]/g, "-").replace(/\s+/g, " ").trim();

function rowFor(path) {
  return [...document.querySelectorAll(".row")].find((r) => r.dataset.path === path);
}
function inlineEdit(row, initial, onCommit) {
  const nm = row.querySelector(".nm");
  const input = document.createElement("input");
  input.className = "rn"; input.value = initial;
  nm.replaceWith(input);
  input.focus(); input.select();
  let done = false;
  const finish = (commit) => {
    if (done) return; done = true;
    const v = sanitizeName(input.value);
    renderTree();
    if (commit && v && v !== initial) onCommit(v);
  };
  input.onkeydown = (e) => {
    if (e.key === "Enter") finish(true);
    if (e.key === "Escape") finish(false);
  };
  input.onblur = () => finish(true);
  input.onclick = (e) => e.stopPropagation();
}
function inlineRename(kind, path) {
  const row = rowFor(path);
  if (!row) return;
  const old = path.split("/").pop().replace(/\.md$/, "");
  inlineEdit(row, old, async (name) => {
    busy(true);
    try {
      say("renaming…");
      await renameItem(kind, path, name);
      say("renamed — site updates in ~1 min", "ok");
    } catch (err) { say(err.message, "err"); await refreshTree(); }
    busy(false);
  });
}
function inlineNewFolder(parent) {
  // temporary row at the right depth, committed on Enter
  closedFolders.delete(parent); saveClosed(); renderTree();
  const container = parent
    ? rowFor(parent).nextElementSibling             // its .children div
    : $("tree");
  const row = document.createElement("div");
  row.className = "row folder";
  row.innerHTML = '<span class="chev">' + CHEV + '</span><span class="nm"></span>';
  container.prepend(row);
  inlineEdit(row, "", async (name) => {
    busy(true);
    try {
      say("creating folder…");
      await createFolder((parent ? parent + "/" : "") + name);
      say("folder created", "ok");
    } catch (err) { say(err.message, "err"); }
    busy(false);
  });
}

/* ── delete (UI wrapper: confirm, then one atomic commit) ── */
async function removeItem(kind, path) {
  if (kind === "note") {
    if (!confirm('Delete "' + path.split("/").pop().replace(/\.md$/, "") + '"?')) return;
  } else {
    const n = allFiles.filter((f) => f.startsWith(path + "/") && f.endsWith(".md")).length;
    if (!confirm('Delete folder "' + path + '"' + (n ? " and the " + n + " note(s) inside" : "") + "?")) return;
  }
  busy(true);
  try {
    say("deleting…");
    await deleteItem(kind, path);
    say("deleted — site updates in ~1 min", "ok");
  } catch (err) { say(err.message, "err"); }
  busy(false);
}

/* ── editor ── */
function confirmLose() { return !dirty || confirm("Discard unpublished changes?"); }
function markDirty(d) { dirty = d; if (d) say("unpublished changes"); else if ($("status").className === "") say(""); }
for (const id of ["f-title", "f-summary", "f-body"]) $(id).oninput = () => markDirty(true);
window.onbeforeunload = () => (dirty ? true : undefined);
document.addEventListener("keydown", (e) => {
  if ((e.metaKey || e.ctrlKey) && e.key === "s") { e.preventDefault(); if ($("app").classList.contains("on")) publish(); }
});

const today = () => {
  const n = new Date();
  return n.getFullYear() + "-" + String(n.getMonth() + 1).padStart(2, "0") + "-" + String(n.getDate()).padStart(2, "0");
};
function parseNote(raw) {
  const m = raw.match(/^---\n([\s\S]*?)\n---\n?/);
  let summary = "", date = "", body = raw;
  if (m) {
    body = raw.slice(m[0].length).replace(/^\n/, "");
    const s = m[1].match(/^summary:\s*"?(.*?)"?\s*$/m);
    const d = m[1].match(/^date:\s*(.*?)\s*$/m);
    if (s) summary = s[1];
    if (d) date = d[1];
  }
  return { summary, date, body };
}
function composeNote() {
  let fm = "---\ndate: " + (currentDate || today()) + "\n";
  const sum = $("f-summary").value.trim();
  if (sum) fm += 'summary: "' + sum.replace(/"/g, "'") + '"\n';
  return fm + "---\n\n" + $("f-body").value.replace(/\s*$/, "") + "\n";
}
function setCrumb() {
  const c = $("crumb");
  c.innerHTML = "";
  const segs = current ? current.replace(/\.md$/, "").split("/")
    : (draftFolder ? draftFolder.split("/").concat("new note") : ["new note"]);
  segs.forEach((s, i) => {
    if (i) { const sep = document.createElement("span"); sep.className = "sep"; sep.textContent = "›"; c.appendChild(sep); }
    c.appendChild(document.createTextNode(s));
  });
}
async function openNote(path) {
  const f = await gh(notePath(path) + "?r=" + Math.random().toString(36).slice(2));
  if (!f) { say("couldn't open " + path, "err"); return; }
  const { summary, date, body } = parseNote(b64ToUtf8(f.content));
  current = path; currentSha = f.sha; currentDate = date;
  $("f-title").value = path.split("/").pop().replace(/\.md$/, "");
  $("f-summary").value = summary; $("f-body").value = body;
  markDirty(false); say("");
  setCrumb(); renderTree();
}
function newDraft(folder) {
  if (!confirmLose()) return;
  current = null; currentSha = null; currentDate = ""; draftFolder = folder || "";
  $("f-title").value = ""; $("f-summary").value = ""; $("f-body").value = "";
  markDirty(false); say("");
  setCrumb(); renderTree();
  $("f-title").focus();
}
$("i-newnote").onclick = () => newDraft(draftFolder);
$("i-newfolder").onclick = () => inlineNewFolder("");

async function publish() {
  busy(true);
  try {
    const name = sanitizeName($("f-title").value) || "Untitled";
    $("f-title").value = name;
    say("publishing…");
    let dest, changes;
    if (!current) {
      dest = (draftFolder ? draftFolder + "/" : "") + name + ".md";
      if (notes.includes(dest)) throw new Error("A note with that name already exists there.");
      changes = [{ path: "notes/" + dest, content: composeNote() }];
    } else {
      const dir = current.includes("/") ? current.slice(0, current.lastIndexOf("/") + 1) : "";
      dest = dir + name + ".md";
      if (dest !== current && notes.includes(dest)) throw new Error("That name is taken.");
      changes = [{ path: "notes/" + dest, content: composeNote() }];
      if (dest !== current) changes.push({ path: "notes/" + current }); // renamed via title
    }
    const c = await commitChanges(changes, "note: " + name);
    current = dest;
    markDirty(false);
    say("published — live in ~1 min", "ok");
    setCrumb();
    await refreshTree(c.tree.sha);
  } catch (err) { say(err.message, "err"); }
  busy(false);
}
$("b-publish").onclick = publish;
$("b-logout").onclick = () => { localStorage.removeItem(LS_KEY); token = null; location.reload(); };

/* ── boot ── */
async function enterApp() {
  $("gate").style.display = "none";
  $("app").classList.add("on");
  setCrumb();
  await refreshTree();
  const want = new URLSearchParams(location.search).get("note");
  if (want && notes.includes(want)) openNote(want);
}
(async () => {
  try { await loadConfig(); } catch (e) { $("g-err").textContent = e.message; }
  if (!config) { setupMode(true); $("g-hint").textContent = "one-time setup on first use"; return; }
  const saved = localStorage.getItem(LS_KEY);
  if (saved) {
    try { token = await decryptToken(saved, config); enterApp(); return; } catch (e) { localStorage.removeItem(LS_KEY); }
  }
})();
</script>
</body>
</html>
