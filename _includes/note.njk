---
layout: layout.njk
---
<article class="note">
  <header class="note-header">
    {%- set crumbs = page.filePathStem | noteCrumbs %}
    {%- if crumbs.length %}<p class="crumbs">{{ crumbs | join(" / ") }}</p>{%- endif %}
    <time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
    <h1>{{ title }}</h1>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="backlink">
    <a href="/">← all notes</a>
    <span class="sep">·</span>
    <a href="/write/?note={{ page.inputPath | replace("./notes/", "") | urlencode }}">edit this note ✎</a>
  </p>
</article>
