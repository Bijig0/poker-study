---
layout: layout.njk
---
<article class="note">
  <header class="note-header">
    <time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
    <h1>{{ title }}</h1>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="backlink"><a href="/">← all notes</a></p>
</article>
