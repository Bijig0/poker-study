---
layout: layout.njk
---
<article class="note">
  <header class="note-header">
    <time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
    <h1>{{ title }}</h1>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="backlink">
    <a href="/">← all notes</a>
    <span class="sep">·</span>
    <a href="https://github.com/Bijig0/poker-study/edit/main/{{ page.inputPath | replace("./", "") }}">edit this note ✎</a>
  </p>
</article>
