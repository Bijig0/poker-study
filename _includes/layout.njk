<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{% if title %}{{ title }} · {% endif %}Poker Study</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>♠</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="masthead">
    <a class="masthead-title" href="/">
      <span class="suits" aria-hidden="true">♠♥♦♣</span>
      Poker Study
    </a>
    <p class="masthead-sub">a running study journal</p>
    <p class="masthead-actions"><a class="write-link" href="/write/">✎ write</a></p>
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer class="colophon">
    <span aria-hidden="true">♦</span> updated whenever the ranges change <span aria-hidden="true">♦</span>
  </footer>
</body>
</html>
