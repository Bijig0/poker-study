#!/bin/sh
# Start a new note: ./note "BB defense vs BTN 2.5x" [folder/subfolder]
# Creates notes/[folder/]YYYY-MM-DD-slug.md and opens it in your editor.
set -e
cd "$(dirname "$0")"
if [ -z "$1" ]; then
  echo "Usage: ./note \"Title of the note\" [folder/subfolder]" >&2
  exit 1
fi
name=$(printf '%s' "$1" | tr '/\\:*?"<>|' '-')
dir="notes${2:+/$2}"
mkdir -p "$dir"
file="$dir/${name}.md"
if [ -e "$file" ]; then
  echo "$file already exists, opening it."
else
  printf -- '---\ndate: %s\n---\n\n' "$(date +%F)" > "$file"
fi
"${EDITOR:-open -t}" "$file" 2>/dev/null || open -t "$file"
echo "$file"
