#!/bin/sh
# Sync notes: pull latest, commit anything local, push.
# Usage: ./sync ["commit message"]
set -e
cd "$(dirname "$0")"
git pull --rebase --autostash
git add -A
git commit -m "${1:-notes: $(date '+%Y-%m-%d %H:%M')}" 2>/dev/null || echo "Nothing new to commit."
git push
echo "Synced. Site rebuilds in ~1 min."
